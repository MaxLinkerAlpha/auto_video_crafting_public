# ===== 素材源 API =====
# 至少配置一个；建议两个都配置以互为 fallback
# Pexels: https://www.pexels.com/api/  注册后免费获取，200/小时 + 20000/月
PEXELS_API_KEY=""

# Pixabay: https://pixabay.com/api/docs/  注册后免费获取，5000/小时
PIXABAY_API_KEY=""

# ===== LLM API =====
# 用于：1) 拉丁语字幕翻译为英语  2) 抽取视觉搜索关键词
# 协议：OpenAI 兼容
# 推荐免费方案：
#   1. 阿里云 DashScope Qwen2.5-7B-Instruct
#      注册地址：https://dashscope.console.aliyun.com/
#      base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
#   2. SiliconFlow GLM-4-9B（免费）
#      注册地址：https://siliconflow.cn/
#      base_url: https://api.siliconflow.cn/v1
LLM_API_KEY=""
LLM_BASE_URL="https://api.siliconflow.cn/v1"
LLM_MODEL="THUDM/glm-4-9b-0414"

# ===== 存储路径（可选） =====
# v1_2_0 新增：大容量文件优先存到移动硬盘
#
# 路径解析优先级（从高到低）：
#   1. 命令行 --output 参数
#   2. 下面两个环境变量
#   3. 移动硬盘自动检测（扫描所有盘符查找 AutoVideoCrafting_Workspace 目录）
#   4. 本地项目目录（./cache/ 和 ./output/）
#
# 大多数情况下无需配置下列变量，让程序自动检测移动硬盘即可。
# 仅当自动检测失败或需指定特殊路径时取消注释：
# CACHE_DIR="E:/AutoVideoCrafting_Workspace/cache"
# OUTPUT_DIR="E:/AutoVideoCrafting_Workspace/output"
